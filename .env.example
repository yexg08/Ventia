# copia este archivo como .env y completa los valores (el archivo .env no se sube a Git)
# se usan solo con el perfil app de docker compose (docker compose --profile app up --build)

# clave de firma de las sesiones (texto aleatorio de 32 caracteres o mas)
JWT_KEY=

# clave del superadmin (admin@ventia.local) con 10 caracteres o mas y al menos un numero
SUPERADMIN_PASSWORD=

# true carga el negocio de ejemplo (Hamburguesas La Cumbre con 30 dias de ventas) la primera vez que arranca
# sus cuentas son dueno@ventia.demo y cajera@ventia.demo con la clave DEMO_PASSWORD (10 caracteres o mas y al menos un numero)
DEMO_DATA=false
DEMO_PASSWORD=
